{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: ERP Helpdesk",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "cwd": "${workspaceFolder}",
            "args": [],
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": true
        },
        {
            "name": "Python: Debug Agent (RouterAgent)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/erp_helpdesk/agents/router_agent.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": false
        }
    ]
}